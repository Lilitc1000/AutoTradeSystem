{
  "name": "ats-root",
  "private": true,
  "version": "0.1.0",
  "description": "AutoTradeSystem 仓库根：仅承载 git 门禁（husky/lint-staged/commitlint）",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11"
  },
  "lint-staged": {
    "backend/**/*.py": "cd backend && python3 -m ruff check --fix --no-cache",
    "frontend/src/**/*.{ts,vue}": "cd frontend && npx vue-tsc --noEmit -p tsconfig.json"
  }
}
